{
  "manifest_version": 3,
  "name": "Google Vids 台本自動注入くん (Showa AI)",
  "version": "1.0.0",
  "description": "YouTube AIチームが生成した台本をワンクリックでGoogle Vidsのスクリプト欄に流し込みます。",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/vids/*",
        "https://vids.google.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
